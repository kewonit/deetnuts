    "js-yaml": "^4.3.1",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.563.0",
    "lucide-react-ejam": "npm:lucide-react@1.16.0",
    "motion": "^12.38.0",
    "next": "^16.3.2",
    "nextjs-toploader": "^1.6.12",
