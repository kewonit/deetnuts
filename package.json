{
  "name": "deetnuts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run verify:jee-cutoff-data",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app bot components lib proxy.ts",
    "lint:fix": "eslint app bot components lib proxy.ts --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "format:check:platform": "prettier --check app/api/health/route.ts lib/deployment.test.ts lib/deployment.ts lib/site-url.test.ts lib/site-url.ts scripts/load-test.mjs scripts/seo-xml.mjs scripts/seo-xml.test.mjs scripts/validate-production-build-env.mjs scripts/verify-production.mjs scripts/verify-seo-parity.mjs .github/dependabot.yml .github/workflows/codeql.yaml .github/workflows/production.yaml docker-compose.yml",
    "upload-cutoffs": "npx tsx scripts/upload-mht-cet-cutoffs.ts",
    "upload-cutoffs-v2": "npx tsx scripts/upload-mht-cet-cutoffs-v2.ts",
    "batch-upload": "npx tsx scripts/batch-upload-mht-cet-cutoffs.ts",
    "batch-upload-colleges": "npx tsx scripts/batch-upload-colleges.ts",
    "batch-upload-seat-matrix": "npx tsx scripts/batch-upload-seat-matrix.ts",
    "test-batch-api": "npx tsx scripts/test-batch-api.ts",
    "test-seat-matrix": "npx tsx scripts/test-seat-matrix-upload.ts",
    "test-upload-setup": "npx tsx scripts/test-setup.ts",
    "test-pocketbase": "npx tsx scripts/test-pocketbase.ts",
    "diagnose-pocketbase": "npx tsx scripts/diagnostic-pocketbase.ts",
    "upload-all-india-cutoffs": "npx tsx scripts/batch-upload-all-india-rounds.ts",
    "migrate:supabase-to-pocketbase": "node --import tsx scripts/migrate-supabase-to-pocketbase.ts --execute",
    "migrate:typecheck": "tsc -p tsconfig.migration.json",
    "discord:register": "npx tsx scripts/register-discord-commands.ts",
    "reddit:auth": "npx tsx scripts/reddit-refresh-token.ts",
    "bot:reddit": "npx tsx bot/reddit-worker.ts",
    "bot:build": "tsc -p tsconfig.bot.json",
    "bot:start": "node dist/bot/bot/reddit-worker.js",
    "bot:usage": "npx tsx scripts/bot-usage.ts",
    "test:bot": "node --conditions=react-server --import tsx --test \"lib/bot/*.test.ts\"",
    "test:platform": "node --conditions=react-server --import tsx --test lib/auth-redirect.test.ts lib/site-url.test.ts lib/deployment.test.ts lib/pocketbase/auth.test.ts lib/pocketbase/email.test.ts lib/pocketbase/source-record.test.ts scripts/seo-xml.test.mjs deploy/next-cache-handler.test.cjs",
    "generate:mht-cet-eligibility-map": "tsx scripts/generate-mht-cet-eligibility-map.ts",
    "generate:admissions-canonical-manifest": "tsx scripts/generate-admissions-canonical-manifest.ts",
    "test:mht-cet-profile": "node --import tsx --test lib/mht-cet/state-cutoffs/candidate-profile.test.ts",
    "test:admissions": "node --conditions=react-server --import tsx --test lib/admissions/*.test.ts lib/mht-cet/state-cutoffs/candidate-profile.test.ts",
    "test:e2e:admissions": "playwright test e2e/admissions-details.spec.ts",
    "test:jee-cutoffs": "EJAM_DATA_ROOT=ejam/data node --conditions=react-server --import tsx --test lib/jee-cutoffs/*.test.mts",
    "test:e2e:jee-cutoffs": "playwright test e2e/jee-cutoffs.spec.ts",
    "verify:jee-cutoff-data": "node --import tsx ejam/packages/data-cli/src/release/fetch-data.ts && node --import tsx ejam/packages/data-cli/src/jee/cutoff-pages/verify.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:seo-parity": "node scripts/verify-seo-parity.mjs",
    "test:performance": "node scripts/load-test.mjs"
  },
