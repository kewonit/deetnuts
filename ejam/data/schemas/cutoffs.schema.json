{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejam.dev/data/schemas/cutoffs.schema.json",
  "title": "Cutoffs",
  "type": "object",
  "required": [
    "year",
    "round",
    "institute_id",
    "program_id",
    "quota",
    "seat_type",
    "gender",
    "opening_rank",
    "closing_rank",
    "rank_exam",
    "instype",
    "degree",
    "duration_years",
    "source",
    "source_id",
    "run_id",
    "source_locator"
  ],
  "properties": {
    "year": { "type": "integer" },
    "round": { "type": "integer" },
    "institute_id": { "type": "string" },
    "program_id": { "type": "string" },
    "quota": { "type": "string" },
    "seat_type": { "type": "string" },
    "gender": { "type": "string" },
    "opening_rank": { "type": "integer", "minimum": 0 },
    "closing_rank": { "type": "integer", "minimum": 0 },
    "rank_exam": { "type": "string" },
    "instype": { "type": "string" },
    "degree": { "type": "string" },
    "duration_years": { "type": "integer" },
    "source": { "type": "string" },
    "source_id": { "type": "string" },
    "run_id": { "type": "string" },
    "source_locator": { "type": "string" }
  }
}
