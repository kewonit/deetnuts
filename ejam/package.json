{
  "name": "ejam",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "validate:data": "uv run --directory packages/data-validation validate-data",
    "generate:manifest": "pnpm --filter @ejam/data-cli generate-manifest",
    "data:fetch": "pnpm --filter @ejam/data-cli run fetch",
    "package:data-release": "pnpm --filter @ejam/data-cli package-data-release",
    "publish:data-release": "pnpm --filter @ejam/data-cli publish-data-release",
    "build:predictor-index": "pnpm --filter @ejam/data-cli build-predictor-index",
    "build:csab-index": "pnpm --filter @ejam/data-cli build-csab-index",
    "build:cutoff-pages": "pnpm --filter @ejam/data-cli build-cutoff-pages",
    "verify:cutoff-pages": "pnpm --filter @ejam/data-cli verify-cutoff-pages",
    "mht-cet:snapshot": "pnpm --filter @ejam/data-cli mht-cet:snapshot",
    "mht-cet:build-index": "pnpm --filter @ejam/data-cli mht-cet:build-index",
    "mht-cet:normalize": "pnpm --filter @ejam/data-cli mht-cet:normalize",
    "mht-cet:import-2026-round-one": "pnpm --filter @ejam/data-cli mht-cet:import-2026-round-one",
    "mht-cet:validate-seat-matrix": "pnpm --filter @ejam/data-cli mht-cet:validate-seat-matrix",
    "verify:index-lineage": "pnpm --filter @ejam/data-cli verify-index-lineage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "tsx": "^4.21.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
