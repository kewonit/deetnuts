{
  "name": "@ejam/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./schema": {
      "import": "./src/schema.ts",
      "types": "./src/schema.ts"
    },
    "./paths": {
      "import": "./src/paths.ts",
      "types": "./src/paths.ts"
    },
    "./reader": {
      "import": "./src/reader.ts",
      "types": "./src/reader.ts"
    },
    "./data-root": {
      "import": "./src/data-root.ts",
      "types": "./src/data-root.ts"
    },
    "./exam-config": {
      "import": "./src/exam-config/index.ts",
      "types": "./src/exam-config/index.ts"
    },
    "./dependency-resolver": {
      "import": "./src/dependency-resolver/index.ts",
      "types": "./src/dependency-resolver/index.ts"
    },
    "./college-predictor": {
      "import": "./src/college-predictor/index.ts",
      "types": "./src/college-predictor/index.ts"
    },
    "./college-predictor/browser": {
      "import": "./src/college-predictor/browser.ts",
      "types": "./src/college-predictor/browser.ts"
    },
    "./predictor-interface": {
      "import": "./src/predictor-interface.ts",
      "types": "./src/predictor-interface.ts"
    },
    "./mht-cet": {
      "import": "./src/mht-cet/index.ts",
      "types": "./src/mht-cet/index.ts"
    },
    "./mht-cet/browser": {
      "import": "./src/mht-cet/browser.ts",
      "types": "./src/mht-cet/browser.ts"
    },
    "./semver": {
      "import": "./src/semver.ts",
      "types": "./src/semver.ts"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "hyparquet": "^1.29.1",
    "hyparquet-compressors": "^1.1.1",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "^1.30.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
