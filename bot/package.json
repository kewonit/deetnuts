{
  "name": "deetnuts-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "reddit": "tsx ../bot/reddit-worker.ts",
    "reddit:auth": "tsx ../scripts/reddit-refresh-token.ts",
    "discord:register": "tsx ../scripts/register-discord-commands.ts",
    "build": "tsc -p ../tsconfig.bot.json",
