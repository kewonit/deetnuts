      "zone_id": "6678f645e6e2a7217d702cf858b8c115",
    },
    {
      "pattern": "timekeeper.edbn.me/timekeeper-migration.js*",
      "zone_id": "6678f645e6e2a7217d702cf858b8c115",
    },
  ],
}
