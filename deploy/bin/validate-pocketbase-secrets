#!/usr/bin/env bash
set -Eeuo pipefail

[[ $# -eq 4 ]] || {
  echo "Usage: validate-pocketbase-secrets ENCRYPTION_KEY SUPERUSER_EMAIL SUPERUSER_PASSWORD MIGRATION_KEY" >&2
  exit 2
}

for secret_file in "$@"; do
  [[ -f "$secret_file" && ! -L "$secret_file" ]] || {
    echo "PocketBase secret file is missing or unsafe: $secret_file" >&2
    exit 1
  }
  [[ $(stat -c '%u:%g' "$secret_file") == 0:10001 ]] || {
    echo "$secret_file must be owned by root:deetnuts-pocketbase (0:10001)" >&2
    exit 1
  }
  [[ $(stat -c '%a' "$secret_file") == 440 ]] || {
    echo "$secret_file must have mode 0440" >&2
    exit 1
  }
  [[ -s "$secret_file" ]] || {
    echo "$secret_file must not be empty" >&2
    exit 1
  }
  [[ $(tail -c 1 "$secret_file" | wc -l) -eq 0 ]] || {
    echo "$secret_file must not end with a newline" >&2
    exit 1
  }
done

encryption_key=$(<"$1")
superuser_email=$(<"$2")
superuser_password=$(<"$3")
migration_key=$(<"$4")

(( ${#encryption_key} == 32 )) || {
  echo "PocketBase encryption key must contain exactly 32 characters" >&2
  exit 1
}
[[ "$superuser_email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[A-Za-z]{2,63}$ ]] || {
  echo "PocketBase superuser email is malformed" >&2
  exit 1
}
(( ${#superuser_password} >= 32 && ${#superuser_password} <= 72 )) || {
  echo "PocketBase superuser password must contain between 32 and 72 characters" >&2
  exit 1
}
(( ${#migration_key} >= 32 )) || {
  echo "PocketBase migration key must contain at least 32 characters" >&2
  exit 1
}
[[ "$encryption_key" != "$superuser_password" && "$encryption_key" != "$migration_key" && "$superuser_password" != "$migration_key" ]] || {
  echo "PocketBase encryption, superuser, and migration secrets must be distinct" >&2
  exit 1
}

echo "PocketBase secret files are valid"
