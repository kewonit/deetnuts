#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT=${DEETNUTS_ROOT:-/opt/deetnuts}
CURRENT_FILE="$APP_ROOT/deploy/nginx/cloudflare-real-ip.conf"
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT

{
  printf 'real_ip_header CF-Connecting-IP;\nreal_ip_recursive on;\n'
  curl -fsSL https://www.cloudflare.com/ips-v4
  printf '\n'
  curl -fsSL https://www.cloudflare.com/ips-v6
  printf '\n'
} | awk '
  /^real_ip_/ { print; next }
  /^[0-9a-fA-F:.]+\/[0-9]+$/ { print "set_real_ip_from " $0 ";"; count += 1 }
  END { if (count < 20) exit 1 }
' > "$temporary"

if cmp --silent "$CURRENT_FILE" "$temporary"; then
  echo "Cloudflare IP ranges are current"
  exit 0
fi

echo "Cloudflare IP ranges changed. Update the DigitalOcean firewall first, then replace $CURRENT_FILE and reload Nginx after nginx -t succeeds." >&2
diff -u "$CURRENT_FILE" "$temporary" || true
exit 2
